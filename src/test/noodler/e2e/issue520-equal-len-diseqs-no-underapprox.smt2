; issue 520: the same in the main stabilization loop (without the underapproximation procedure)
(set-info :status sat)
(set-option :timeout 10000)
(set-option :smt.str.underapprox false)
(set-logic QF_SLIA)
(declare-fun x () String)
(declare-fun y1 () String)
(declare-fun y2 () String)
(declare-fun y3 () String)
(declare-fun y4 () String)
(declare-fun y5 () String)
(declare-fun y6 () String)
(assert (not (= x y1)))
(assert (= (str.len x) (str.len y1)))
(assert (not (= x y2)))
(assert (= (str.len x) (str.len y2)))
(assert (not (= x y3)))
(assert (= (str.len x) (str.len y3)))
(assert (not (= x y4)))
(assert (= (str.len x) (str.len y4)))
(assert (not (= x y5)))
(assert (= (str.len x) (str.len y5)))
(assert (not (= x y6)))
(assert (= (str.len x) (str.len y6)))
(check-sat)

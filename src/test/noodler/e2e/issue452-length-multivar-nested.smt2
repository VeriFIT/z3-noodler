(set-info :status unsat)
(declare-fun x () String)
(declare-fun z () String)
(declare-fun v () String)
(declare-fun p () String)
(push 1)
(assert (= x (str.++ "bbaaa" z)))
(assert (= (str.++ z x) (str.++ "ab" v "bbb")))
(assert (= (str.len z) (+ (str.len p) 3)))
(assert (<= (str.len p) 0))
(check-sat)

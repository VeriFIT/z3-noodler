; issue #519: (reset) used to leave the input rewriter bound to the freed ast_manager
(set-logic QF_LIA)
(declare-const x Int)
(assert (> x 0))
(check-sat)
(reset)
(set-logic QF_SLIA)
(set-info :status sat)
(declare-const x Int)
(declare-const s String)
(assert (> x 0))
(assert (= (str.len s) x))
(assert (str.in_re s (re.+ (str.to_re "ab"))))
(check-sat)

(set-logic QF_S)
(set-info :status sat)
(declare-fun X () String)(declare-fun Y1 () String)(declare-fun Y2 () String)
(declare-fun Z1 () String)(declare-fun Z2 () String)
(assert (or (= X "zz") (and (= X (str.++ Y1 "aa" Y2)) (= X (str.++ Z1 "aa" Z2)))))
(assert (str.in_re X (re.+ (str.to_re "a"))))
(assert (str.in_re Y1 (re.union (str.to_re "a") (str.to_re "aaa"))))
(assert (str.in_re Z1 (re.* (str.to_re "b"))))
(check-sat)

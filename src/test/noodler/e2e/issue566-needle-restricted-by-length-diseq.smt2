(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (str.in_re x (re.+ (re.union (str.to_re "a") (str.to_re "b")))))
(assert (str.in_re y (re.union (str.to_re "a") (str.to_re "b"))))
(assert (str.in_re z (re.++ (re.union (str.to_re "a") (str.to_re "b")) (re.* (re.union (str.to_re "a") (str.to_re "b"))))))
(assert (= (str.len x) 1))
(assert (not (= x y)))
(assert (not (str.contains z x)))
(assert (not (str.contains z y)))
(check-sat)

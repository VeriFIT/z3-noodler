; issue 434: an unsat underapproximate LIA of the length procedure must not block the string constraint
(set-info :status sat)
(declare-const x String)
(declare-const y String)
(declare-const a1 String) (declare-const b1 String)
(declare-const a2 String) (declare-const b2 String)
(declare-const a3 String) (declare-const b3 String)
(declare-const a4 String) (declare-const b4 String)
(declare-const a5 String) (declare-const b5 String)
(declare-const a6 String) (declare-const b6 String)
(declare-const a7 String) (declare-const b7 String)
(declare-const a8 String) (declare-const b8 String)
(declare-const a9 String) (declare-const b9 String)
(declare-const a10 String) (declare-const b10 String)
(assert (= (str.++ a1 "d") (str.++ b1 "c" x)))
(assert (= (str.++ a2 "d") (str.++ b2 "c" x)))
(assert (= (str.++ a3 "d") (str.++ b3 "c" x)))
(assert (= (str.++ a4 "d") (str.++ b4 "c" x)))
(assert (= (str.++ a5 "d") (str.++ b5 "c" x)))
(assert (= (str.++ a6 "d") (str.++ b6 "c" x)))
(assert (= (str.++ a7 "d") (str.++ b7 "c" x)))
(assert (= (str.++ a8 "d") (str.++ b8 "c" x)))
(assert (= (str.++ a9 "d") (str.++ b9 "c" x)))
(assert (= (str.++ a10 "d") (str.++ b10 "c" x)))
(assert (not (= x y)))
(assert (= (str.len x) (str.len y)))
(check-sat)

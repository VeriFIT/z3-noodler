; Generic sequences (Seq Int) with extended functions.
(set-info :smt-lib-version 2.6)
(set-info :status sat)
(declare-const s (Seq Int))
(declare-const t (Seq Int))
(assert (seq.prefixof (seq.unit 1) s))
(assert (seq.suffixof (seq.unit 9) s))
(assert (seq.contains s (seq.++ (seq.unit 2) (seq.unit 3))))
(assert (not (seq.contains s (seq.unit 4))))
(assert (= (seq.extract s 1 2) (seq.++ (seq.unit 2) (seq.unit 3))))
(assert (= (seq.at s 3) (seq.unit 5)))
(assert (= (seq.indexof s (seq.unit 5) 0) 3))
(assert (= (seq.replace s (seq.unit 5) (seq.unit 6)) t))
(assert (= (seq.len s) 6))
(check-sat)

(set-logic QF_S)
(set-info :status unsat)
(declare-const x String)
(assert (not (= x "b")))
(assert (not (= x "c")))
(assert (not (= x "bb")))
(assert (not (= x "cc")))
(assert (not (= x "bc")))
(assert (not (= x "cb")))
(assert (not (= x "bbb")))
(assert (not (= x "ccc")))
(assert (not (= x "bcb")))
(assert (not (= x "cbc")))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 1 2) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 2 3) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 3 4) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 4 5) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 5 6) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 6 7) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 7 8) (str.to_re "a")) (re.* re.allchar))))
(assert (str.in_re x (re.++ (re.* re.allchar) ((_ re.loop 8 9) (str.to_re "a")) (re.* re.allchar))))
(assert (not (str.in_re x (re.++ ((_ re.loop 2 2) (re.union (str.to_re "b") (str.to_re "c"))) (re.* re.allchar)))))
(assert (not (str.in_re x (re.++ ((_ re.loop 3 3) (re.union (str.to_re "b") (str.to_re "c"))) (re.* re.allchar)))))
(assert (not (str.in_re x (re.++ ((_ re.loop 4 4) (re.union (str.to_re "b") (str.to_re "c"))) (re.* re.allchar)))))
(assert (not (str.in_re x (re.++ ((_ re.loop 5 5) (re.union (str.to_re "b") (str.to_re "c"))) (re.* re.allchar)))))
(assert (str.in_re x ((_ re.loop 20 20) (re.union (str.to_re "a") (str.to_re "b")))))
(assert (not (str.in_re x (re.++ (str.to_re "a") (re.* re.allchar)))))
(assert (not (str.in_re x (re.++ (str.to_re "b") (re.* re.allchar)))))
(check-sat)

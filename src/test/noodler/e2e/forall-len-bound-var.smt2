(set-logic ALL)
(set-info :status sat)
(declare-fun f (Int) String)
(declare-fun x () String)
(declare-fun y () String)
(assert (forall ((i Int)) (=> (and (>= i 0) (<= i 1)) (= (str.len (f i)) i))))
(assert (= (str.++ x "a") (str.++ "a" y)))
(assert (= (str.len x) (- (* 2 (str.len y)) 3)))
(check-sat)

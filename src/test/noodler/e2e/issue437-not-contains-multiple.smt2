(set-logic QF_SLIA)
(set-info :status unsat)
; issue #437: every not-contains has to be encoded, not only the first one
(declare-fun x () String)
(declare-fun y () String)
(declare-fun z () String)
(declare-fun w () String)
(assert (str.in_re x (re.* (str.to_re "b"))))
(assert (str.in_re y (re.* (str.to_re "b"))))
(assert (str.in_re z (re.* (str.to_re "a"))))
(assert (str.in_re w (re.* (str.to_re "a"))))
(assert (not (str.contains x y)))
(assert (not (str.contains z w)))
(assert (<= (str.len w) (str.len z)))
(check-sat)

(set-info :status unsat)
(declare-fun a () String)
(declare-fun b () String)
(declare-fun c () String)
(declare-fun z () String)
(declare-fun w () String)
(declare-fun w2 () String)
(declare-fun p () String)
(push 1)
(assert (= a (str.++ z "1")))
(assert (= b (str.++ "2" z)))
(assert (= c (str.++ a b)))
(assert (= c (str.++ "q" w)))
(assert (= c (str.++ w2 "r")))
(assert (= (str.len z) (+ (str.len p) 1)))
(assert (<= (str.len p) 0))
(check-sat)

; Generic sequences over 2-bit bit-vectors: 4 distinct sequences of length 1 exist.
(set-info :smt-lib-version 2.6)
(set-info :status sat)
(declare-const x1 (Seq (_ BitVec 2)))
(declare-const x2 (Seq (_ BitVec 2)))
(declare-const x3 (Seq (_ BitVec 2)))
(declare-const x4 (Seq (_ BitVec 2)))
(declare-const b (_ BitVec 2))
(assert (= (seq.len x1) 1))
(assert (= (seq.len x2) 1))
(assert (= (seq.len x3) 1))
(assert (= (seq.len x4) 1))
(assert (distinct x1 x2 x3 x4))
(assert (= x1 (seq.unit b)))
(assert (bvugt b #b01))
(check-sat)

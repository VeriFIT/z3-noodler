(set-info :status sat)
(declare-fun y () String)
(declare-fun u () String)
(declare-fun v () String)
(declare-fun s () String)
(declare-fun w () String)
(declare-fun p () String)
(declare-fun t () String)
(declare-fun r () String)
(push 1)
(assert (= y (str.++ u v)))
(assert (= u (str.++ s w)))
(assert (= p (str.++ y "c")))
(assert (= p (str.++ "ab" t)))
(assert (= r (str.++ "d" y)))
(assert (>= (str.len s) 1))
(assert (>= (str.len w) 1))
(check-sat)
(get-model)

; Generic sequences over an enumeration datatype.
(set-info :smt-lib-version 2.6)
(set-info :status sat)
(declare-datatypes ((Color 0)) (((red) (green) (blue))))
(declare-const x (Seq Color))
(declare-const y (Seq Color))
(declare-const c Color)
(assert (= x (seq.++ (seq.unit c) y)))
(assert (not (= c red)))
(assert (not (= c green)))
(assert (= (seq.len y) 2))
(assert (not (seq.contains x (seq.unit red))))
(assert (not (= y (seq.++ (seq.unit blue) (seq.unit blue)))))
(check-sat)

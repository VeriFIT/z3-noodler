(set-logic QF_S)
(set-info :status unsat)
(declare-fun X () String)(declare-fun Y () String)(declare-fun U () String)
(declare-fun U2 () String)(declare-fun V () String)(declare-fun W () String)
(assert (or (= X "zz") (and (= X (str.++ Y V)) (= X (str.++ Y U)) (= X (str.++ Y U2 W)))))
(assert (str.in_re X (re.+ (str.to_re "a"))))
(assert (str.in_re Y (re.+ (str.to_re "b"))))
(assert (str.in_re U (re.union (str.to_re "ab") (str.to_re "ba"))))
(assert (str.in_re U2 (re.union (str.to_re "ab") (str.to_re "ba"))))
(check-sat)

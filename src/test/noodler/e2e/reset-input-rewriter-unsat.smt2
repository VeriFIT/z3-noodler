; issue #519: the input rewriter (str.to_code rewriting) has to work for the new manager after (reset)
(set-logic QF_SLIA)
(declare-const s String)
(assert (= s "b"))
(check-sat)
(reset)
(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const s String)
(assert (= (str.to_code s) 97))
(assert (not (= s "a")))
(check-sat)

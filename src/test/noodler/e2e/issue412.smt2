(set-logic QF_SLIA)
(set-info :status unsat)
(declare-const x String)
(declare-const y String)
(declare-const s String)
(declare-const t String)
(assert (= x (str.++ "ab" s)))
(assert (= y (str.substr x 0 (+ 1 (str.indexof x s 0)))))
(assert (= (str.replace y s "cd") "abcd"))
(assert (str.in_re s (re.++ (re.range "e" "g") (re.range "e" "g"))))
(check-sat)

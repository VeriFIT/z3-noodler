(set-info :status unsat)
; string equation in the condition of a nested ite (both polarities)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (or (ite (= x "a") (= y "bbb") (= y "ccc")) (= z "c")))
(assert (= (str.len z) 2))
(assert (str.in_re y (re.+ (str.to_re "c"))))
(assert (= (str.len y) 3))
(assert (str.in_re x (re.++ (str.to_re "a") (re.* (str.to_re "b")))))
(assert (not (str.in_re x (re.++ (str.to_re "a") (re.+ (str.to_re "b"))))))
(check-sat)

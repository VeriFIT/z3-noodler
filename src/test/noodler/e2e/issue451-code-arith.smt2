(set-logic ALL)
(set-info :status sat)
(declare-const a String)
(declare-const v1 String)
(declare-const v2 String)
(declare-const w1 String)
(declare-const k Int)
(assert (= v2 a))
(assert (str.in_re (str.++ v1 w1) (str.to_re "ab")))
(assert (str.in_re v1 re.allchar))
(assert (> k 0))
(assert (= (+ (str.to_code v1) k) (str.to_code v2)))
(check-sat)

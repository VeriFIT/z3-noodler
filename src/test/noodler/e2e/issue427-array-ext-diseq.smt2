(set-logic ALL)
(set-info :status sat)
(declare-const a (Array Bool String))
(declare-const b (Array Bool String))
(assert (str.in_re (select a true) (re.union (str.to_re "a") (str.to_re "b"))))
(assert (str.in_re (select a false) (re.union (str.to_re "a") (str.to_re "b"))))
(assert (str.in_re (select b true) (re.union (str.to_re "a") (str.to_re "b"))))
(assert (str.in_re (select b false) (re.union (str.to_re "a") (str.to_re "b"))))
(assert (not (= a b)))
(check-sat)
(get-model)

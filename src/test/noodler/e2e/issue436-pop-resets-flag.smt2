; issue 436: after popping the scope with the underapproximation, a genuine unsat is reported as unsat
(set-info :status unsat)
(declare-fun x () String)
(declare-fun y () String)
(declare-fun n () Int)
(push 1)
(assert (= n (str.to_int (str.++ x y))))
(assert (str.in_re x (re.+ (re.range "0" "9"))))
(assert (> n 123456789))
(check-sat)
(pop 1)
(push 1)
(assert (str.in_re x (re.+ (str.to_re "a"))))
(assert (str.in_re (str.++ x y) (re.+ (str.to_re "b"))))
(check-sat)
(pop 1)

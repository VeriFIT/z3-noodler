(set-logic QF_S)
(set-option :produce-models true)
(set-info :status unsat)
(declare-const x String)
(declare-const s String)
(declare-const t String)
(assert (= x (str.++ "ab" s)))
(assert (= (str.replace (str.substr x 0 (+ 1 (str.indexof x s 0))) s t) "abcd"))
(assert (str.in_re s (re.++ (re.range "c" "f") (re.range "c" "f"))))
(check-sat)

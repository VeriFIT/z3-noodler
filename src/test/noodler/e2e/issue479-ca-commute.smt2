(set-info :status sat)
(set-option :smt.str.ca_constr true)
(set-option :smt.str.postpone_diseqs_stabilization false)
(declare-fun x () String)
(declare-fun y () String)
(assert (str.in_re x (re.* (re.union (str.to_re "a") (str.to_re "b")))))
(assert (str.in_re y (re.* (re.union (str.to_re "a") (str.to_re "b")))))
(assert (not (= (str.++ x y) (str.++ y x))))
(assert (= (str.len x) 2))
(assert (= (str.len y) 2))
(check-sat)
